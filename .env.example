# Docker administrator (only for provisioning)
POSTGRES_ADMIN_PASSWORD=
# Backend runtime: backend schema DML only
CAST_DB_PASSWORD=
# AI runtime: ai schema DML only; do not provide this to the backend process
CAST_AI_DB_PASSWORD=
# Flyway-only schema owner; no model/runtime code uses this account
CAST_MIGRATION_DB_PASSWORD=
# Server-to-server secrets: independently generated, at least 32 characters
CAST_AI_CALLBACK_TOKEN=
CAST_AI_API_TOKEN=
# Required: Base64-encoded cryptographically random JWT key (at least 32 decoded bytes)
CAST_JWT_SECRET_BASE64=
# Comma-separated explicit frontend origins; no wildcard or trailing slash
CAST_CORS_ALLOWED_ORIGINS=http://localhost:5173
